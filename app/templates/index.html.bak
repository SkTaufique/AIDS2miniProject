<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Veritas AI — Multimodal Fake Content Detection</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-dark: #080B11;
      --bg-card: rgba(18, 24, 38, 0.7);
      --bg-card-hover: rgba(26, 34, 52, 0.85);
      --border-color: rgba(255, 255, 255, 0.08);
      --border-highlight: rgba(99, 102, 241, 0.4);
      --primary: #6366F1;
      --primary-glow: rgba(99, 102, 241, 0.35);
      --accent-cyan: #06B6D4;
      --accent-purple: #8B5CF6;
      --text-main: #F3F4F6;
      --text-muted: #94A3B8;
      --success: #10B981;
      --success-glow: rgba(16, 185, 129, 0.25);
      --danger: #EF4444;
      --danger-glow: rgba(239, 68, 68, 0.3);
      --warning: #F59E0B;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
    }

    /* Ambient lighting backgrounds */
    .glow-circle-1 {
      position: fixed;
      top: -150px;
      left: -100px;
      width: 550px;
      height: 550px;
      background: radial-gradient(circle, rgba(99, 102, 241, 0.18) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }
    .glow-circle-2 {
      position: fixed;
      bottom: -150px;
      right: -100px;
      width: 650px;
      height: 650px;
      background: radial-gradient(circle, rgba(6, 182, 212, 0.14) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    /* Navigation */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(16px);
      background: rgba(8, 11, 17, 0.75);
      border-bottom: 1px solid var(--border-color);
      padding: 1rem 2.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .brand-icon {
      width: 36px;
      height: 36px;
      background: linear-gradient(135deg, var(--primary), var(--accent-cyan));
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 20px var(--primary-glow);
    }
    .brand-icon svg {
      width: 20px;
      height: 20px;
      fill: #fff;
    }
    .brand-name {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      background: linear-gradient(to right, #ffffff, #c7d2fe);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .brand-tag {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--accent-cyan);
      background: rgba(6, 182, 212, 0.12);
      border: 1px solid rgba(6, 182, 212, 0.3);
      padding: 2px 8px;
      border-radius: 9999px;
      margin-left: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .system-status-pill {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.8rem;
      color: var(--text-muted);
      background: rgba(255, 255, 255, 0.04);
      padding: 0.4rem 1rem;
      border-radius: 9999px;
      border: 1px solid var(--border-color);
    }
    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--success);
      box-shadow: 0 0 8px var(--success);
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0% { opacity: 0.6; }
      50% { opacity: 1; }
      100% { opacity: 0.6; }
    }

    /* Main Container */
    main {
      position: relative;
      z-index: 10;
      max-width: 1400px;
      margin: 2rem auto;
      padding: 0 1.5rem;
    }

    .hero-banner {
      text-align: center;
      margin-bottom: 2.5rem;
    }
    .hero-banner h1 {
      font-size: 2.5rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      margin-bottom: 0.6rem;
    }
    .hero-banner p {
      color: var(--text-muted);
      font-size: 1.05rem;
      max-width: 700px;
      margin: 0 auto;
    }

    /* Grid layout */
    .dashboard-grid {
      display: grid;
      grid-template-columns: 1fr 1.15fr;
      gap: 1.75rem;
      align-items: start;
    }

    @media (max-width: 1024px) {
      .dashboard-grid {
        grid-template-columns: 1fr;
      }
    }

    /* Cards */
    .glass-card {
      background: var(--bg-card);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border-color);
      border-radius: 20px;
      padding: 1.75rem;
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
      transition: all 0.3s ease;
    }
    .glass-card:hover {
      border-color: rgba(255, 255, 255, 0.15);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.25rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border-color);
    }
    .card-title {
      font-size: 1.1rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* Benchmark quick selectors */
    .quick-samples {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }
    .sample-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      font-weight: 600;
    }
    .sample-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .chip {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 0.45rem 0.85rem;
      font-size: 0.78rem;
      font-weight: 500;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .chip:hover {
      background: rgba(99, 102, 241, 0.18);
      border-color: var(--primary);
      transform: translateY(-1px);
    }
    .chip.active {
      background: var(--primary);
      border-color: var(--primary);
      color: white;
      box-shadow: 0 0 12px var(--primary-glow);
    }

    /* Form inputs */
    .form-group {
      margin-bottom: 1.25rem;
    }
    .form-group label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: #e2e8f0;
    }
    textarea {
      width: 100%;
      background: rgba(10, 14, 23, 0.8);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 0.85rem 1rem;
      color: var(--text-main);
      font-size: 0.95rem;
      line-height: 1.5;
      resize: vertical;
      min-height: 90px;
      outline: none;
      transition: all 0.2s ease;
    }
    textarea:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-glow);
    }

    /* Dropzone */
    .dropzone {
      border: 2px dashed rgba(255, 255, 255, 0.15);
      border-radius: 14px;
      padding: 1.5rem;
      text-align: center;
      cursor: pointer;
      background: rgba(10, 14, 23, 0.5);
      position: relative;
      transition: all 0.25s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 170px;
    }
    .dropzone:hover, .dropzone.dragover {
      border-color: var(--primary);
      background: rgba(99, 102, 241, 0.08);
    }
    .dropzone input[type="file"] {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
    }
    .dropzone-icon {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.05);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.75rem;
      color: var(--text-muted);
    }
    .dropzone-text {
      font-size: 0.9rem;
      font-weight: 500;
      color: #e2e8f0;
    }
    .dropzone-sub {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.25rem;
    }

    /* Image Preview Container */
    .preview-container {
      display: none;
      position: relative;
      width: 100%;
      border-radius: 12px;
      overflow: hidden;
      margin-top: 0.75rem;
      border: 1px solid var(--border-color);
      max-height: 220px;
    }
    .preview-img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      display: block;
    }
    .remove-img-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(0, 0, 0, 0.75);
      color: white;
      border: none;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      transition: 0.2s;
    }
    .remove-img-btn:hover {
      background: var(--danger);
    }

    /* Submit Button */
    .btn-submit {
      width: 100%;
      background: linear-gradient(135deg, var(--primary), var(--accent-purple));
      color: white;
      border: none;
      border-radius: 12px;
      padding: 1rem;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 8px 24px var(--primary-glow);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      margin-top: 1.5rem;
    }
    .btn-submit:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(99, 102, 241, 0.5);
    }
    .btn-submit:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    /* Spinner */
    .spinner {
      display: none;
      width: 20px;
      height: 20px;
      border: 3px solid rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      border-top-color: white;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Right column: Results display */
    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      min-height: 480px;
      color: var(--text-muted);
      padding: 2rem;
    }
    .empty-state svg {
      width: 64px;
      height: 64px;
      stroke: rgba(255, 255, 255, 0.15);
      margin-bottom: 1.25rem;
    }

    .results-container {
      display: none;
      animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Verdict Card */
    .verdict-banner {
      border-radius: 16px;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border: 1px solid transparent;
      position: relative;
      overflow: hidden;
    }
    .verdict-banner.fake {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.15), rgba(185, 28, 28, 0.05));
      border-color: rgba(239, 68, 68, 0.4);
      box-shadow: 0 0 30px var(--danger-glow);
    }
    .verdict-banner.authentic {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(4, 120, 87, 0.05));
      border-color: rgba(16, 185, 129, 0.4);
      box-shadow: 0 0 30px var(--success-glow);
    }

    .verdict-info h3 {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin-bottom: 0.25rem;
    }
    .verdict-title {
      font-size: 1.7rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .verdict-banner.fake .verdict-title { color: #FCA5A5; }
    .verdict-banner.authentic .verdict-title { color: #6EE7B7; }

    /* Confidence circular gauge */
    .gauge-circle {
      position: relative;
      width: 80px;
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .gauge-circle svg {
      width: 80px;
      height: 80px;
      transform: rotate(-90deg);
    }
    .gauge-bg {
      fill: none;
      stroke: rgba(255, 255, 255, 0.1);
      stroke-width: 6;
    }
    .gauge-bar {
      fill: none;
      stroke-width: 6;
      stroke-linecap: round;
      stroke-dasharray: 226;
      stroke-dashoffset: 60;
      transition: stroke-dashoffset 1s ease;
    }
    .gauge-text {
      position: absolute;
      font-size: 0.95rem;
      font-weight: 800;
      font-family: 'JetBrains Mono', monospace;
    }

    /* Diagnostics Grid */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .metric-card {
      background: rgba(10, 14, 23, 0.6);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 1rem;
    }
    .metric-title {
      font-size: 0.75rem;
      color: var(--text-muted);
      font-weight: 600;
      margin-bottom: 0.4rem;
    }
    .metric-value {
      font-size: 1.25rem;
      font-weight: 800;
      font-family: 'JetBrains Mono', monospace;
      margin-bottom: 0.4rem;
    }
    .progress-bar-bg {
      width: 100%;
      height: 6px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 9999px;
      overflow: hidden;
    }
    .progress-bar-fill {
      height: 100%;
      border-radius: 9999px;
      transition: width 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* XAI Visual inspection tabs */
    .xai-section {
      background: rgba(10, 14, 23, 0.6);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .tab-header {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1rem;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 0.5rem;
    }
    .tab-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 0.82rem;
      font-weight: 600;
      padding: 0.4rem 0.8rem;
      border-radius: 6px;
      cursor: pointer;
      transition: 0.2s;
    }
    .tab-btn:hover {
      color: white;
    }
    .tab-btn.active {
      color: var(--primary);
      background: rgba(99, 102, 241, 0.15);
    }
    .tab-content {
      display: none;
      text-align: center;
    }
    .tab-content.active {
      display: block;
    }
    .xai-image {
      max-height: 250px;
      border-radius: 10px;
      border: 1px solid var(--border-color);
      margin: 0 auto 0.75rem auto;
      display: block;
    }
    .xai-caption {
      font-size: 0.78rem;
      color: var(--text-muted);
      line-height: 1.4;
    }

    /* Reasons List */
    .reasons-box {
      background: rgba(10, 14, 23, 0.6);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 1.25rem;
    }
    .reasons-title {
      font-size: 0.85rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
      color: #e2e8f0;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .reasons-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .reasons-list li {
      font-size: 0.82rem;
      color: #cbd5e1;
      padding: 0.5rem 0.75rem;
      background: rgba(255, 255, 255, 0.03);
      border-radius: 8px;
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      line-height: 1.4;
    }
    .reasons-list li::before {
      content: "•";
      color: var(--primary);
      font-weight: bold;
      font-size: 1.2rem;
      line-height: 1;
    }

    /* Live Fact Check Grounding Card */
    .factcheck-box {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.12), rgba(185, 28, 28, 0.05));
      border: 1px solid rgba(239, 68, 68, 0.4);
      border-radius: 14px;
      padding: 1.15rem 1.25rem;
      margin-bottom: 1.5rem;
      box-shadow: 0 0 25px rgba(239, 68, 68, 0.15);
      animation: fadeIn 0.3s ease;
    }
    .factcheck-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.6rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .factcheck-badge {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      padding: 3px 8px;
      border-radius: 6px;
      border: 1px solid rgba(239, 68, 68, 0.5);
      background: rgba(239, 68, 68, 0.2);
      color: #fca5a5;
    }
    .factcheck-source {
      font-size: 0.8rem;
      color: #cbd5e1;
      font-weight: 600;
    }
    .factcheck-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.4;
      margin-bottom: 0.6rem;
    }
    .factcheck-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: #38bdf8;
      font-size: 0.82rem;
      font-weight: 600;
      text-decoration: none;
      transition: 0.2s;
    }
    .factcheck-link:hover {
      color: #7dd3fc;
      text-decoration: underline;
    }

    /* Modality Tabs Navigation */
    .modality-nav {
      display: flex;
      gap: 0.5rem;
      background: rgba(255, 255, 255, 0.04);
      padding: 0.35rem;
      border-radius: 12px;
      border: 1px solid var(--border-color);
      margin-bottom: 1.25rem;
    }
    .modality-tab {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      padding: 0.65rem 0.5rem;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-muted);
      background: transparent;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .modality-tab:hover {
      color: var(--text-main);
      background: rgba(255, 255, 255, 0.05);
    }
    .modality-tab.active {
      color: #fff;
      background: linear-gradient(135deg, var(--primary), var(--accent-purple));
      box-shadow: 0 4px 12px var(--primary-glow);
    }

    /* Media Player Previews */
    .media-preview-box {
      margin-top: 0.75rem;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border-color);
      background: rgba(0, 0, 0, 0.5);
      display: none;
      position: relative;
    }
    .media-preview-box video {
      width: 100%;
      max-height: 240px;
      display: block;
      outline: none;
    }
    .media-preview-box audio {
      width: 100%;
      padding: 0.5rem;
      outline: none;
      display: block;
    }
    .media-clear-btn {
      position: absolute;
      top: 8px;
      right: 8px;
      background: rgba(0, 0, 0, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #fff;
      border-radius: 50%;
      width: 26px;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 10;
      transition: 0.2s;
    }
    .media-clear-btn:hover {
      background: var(--danger);
    }

    /* Video Keyframes Strip */
    .keyframes-card {
      background: rgba(10, 14, 23, 0.6);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 1rem;
      margin-bottom: 1.25rem;
      display: none;
    }
    .keyframes-title {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--accent-cyan);
      margin-bottom: 0.6rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .keyframes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(95px, 1fr));
      gap: 0.5rem;
    }
    .keyframe-thumb {
      width: 100%;
      aspect-ratio: 16/9;
      object-fit: cover;
      border-radius: 6px;
      border: 1px solid var(--border-color);
      transition: transform 0.2s;
    }
    .keyframe-thumb:hover {
      transform: scale(1.05);
      border-color: var(--primary);
    }

    /* Speech Transcript Box */
    .transcript-box {
      background: linear-gradient(135deg, rgba(6, 182, 212, 0.08), rgba(99, 102, 241, 0.05));
      border: 1px solid rgba(6, 182, 212, 0.3);
      border-radius: 14px;
      padding: 1.1rem;
      margin-bottom: 1.25rem;
      display: none;
    }
    .transcript-header {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--accent-cyan);
      margin-bottom: 0.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .transcript-content {
      font-size: 0.92rem;
      color: #f8fafc;
      line-height: 1.5;
      font-style: italic;
    }
  </style>
</head>
<body>

  <div class="glow-circle-1"></div>
  <div class="glow-circle-2"></div>

  <!-- Header -->
  <header>
    <div class="brand">
      <div class="brand-icon">
        <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
      </div>
      <div>
        <span class="brand-name">VERITAS MULTIMODAL</span>
        <span class="brand-tag">Sem 7 Project</span>
      </div>
    </div>
    <div class="system-status-pill">
      <div class="status-dot"></div>
      <span id="gpuStatusText">GPU: NVIDIA RTX 3050 (CUDA)</span>
    </div>
  </header>

  <!-- Main Content -->
  <main>
    <div class="hero-banner">
      <h1>Multimodal Fake Content Detection</h1>
      <p>Cross-modal alignment of textual claims and visual evidence using OpenCLIP ViT-B/32, Error Level Forensics, and Deep Fusion.</p>
    </div>

    <div class="dashboard-grid">
      <!-- Left Column: Input Form -->
      <section class="glass-card">
        <div class="card-header">
          <h2 class="card-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            Evidence Ingestion
          </h2>
        </div>

        <!-- Modality Selector -->
        <div class="modality-nav">
          <button type="button" class="modality-tab active" id="tabModImage" onclick="switchModality('image')">
            🖼️ Image + Text
          </button>
          <button type="button" class="modality-tab" id="tabModVideo" onclick="switchModality('video')">
            🎥 Video Verification
          </button>
          <button type="button" class="modality-tab" id="tabModAudio" onclick="switchModality('audio')">
            🎙️ Audio / Speech
          </button>
        </div>

        <!-- Quick benchmark samples (visible for Image mode) -->
        <div class="quick-samples" id="quickSamplesBox">
          <div class="sample-label">Quick Load Evaluation Benchmarks:</div>
          <div class="sample-chips" id="sampleChips">
            <button type="button" class="chip active" onclick="loadSample(0)">1. Cheapfake (Tokyo Earthquake)</button>
            <button type="button" class="chip" onclick="loadSample(1)">2. Authentic (NASA Webb)</button>
            <button type="button" class="chip" onclick="loadSample(2)">3. AI-Synthetic (Antarctic Saucer)</button>
            <button type="button" class="chip" onclick="loadSample(3)">4. Authentic (Mumbai Monsoon)</button>
          </div>
        </div>

        <form id="detectForm">
          <!-- Text Claim Input -->
          <div class="form-group">
            <label for="headlineText" id="textInputLabel">News Claim / Headline / Narrative:</label>
            <textarea id="headlineText" name="text" placeholder="Paste news headline, tweet caption, or article statement here..."></textarea>
          </div>

          <!-- 1. Image Modality Section -->
          <div class="form-group" id="imageInputGroup">
            <label>Accompanying Image Evidence:</label>
            <div class="dropzone" id="dropzone">
              <input type="file" id="imageInput" name="image" accept="image/*">
              <div class="dropzone-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              </div>
              <div class="dropzone-text">Drag & drop photo here, or click to browse</div>
              <div class="dropzone-sub">Supports JPG, PNG, WEBP (Max 15MB)</div>
            </div>

            <div class="preview-container" id="previewContainer">
              <img id="previewImg" class="preview-img" alt="Preview">
              <button type="button" class="remove-img-btn" onclick="clearImage()">✕</button>
            </div>
          </div>

          <!-- 2. Video Modality Section -->
          <div class="form-group" id="videoInputGroup" style="display: none;">
            <label>Video Footage Evidence:</label>
            <div class="dropzone" id="videoDropzone">
              <input type="file" id="videoInput" name="video" accept="video/mp4,video/webm,video/quicktime,video/x-msvideo">
              <div class="dropzone-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
              </div>
              <div class="dropzone-text">Drag & drop video clip, or click to browse</div>
              <div class="dropzone-sub">Supports MP4, WEBM, MOV, AVI (Max 50MB)</div>
            </div>

            <div class="media-preview-box" id="videoPreviewContainer">
              <button type="button" class="media-clear-btn" onclick="clearVideo()">✕</button>
              <video id="videoPlayer" controls></video>
            </div>
          </div>

          <!-- 3. Audio Modality Section -->
          <div class="form-group" id="audioInputGroup" style="display: none;">
            <label>Speech / Audio Recording:</label>
            <div class="dropzone" id="audioDropzone">
              <input type="file" id="audioInput" name="audio" accept="audio/mpeg,audio/wav,audio/mp4,audio/ogg,audio/x-m4a">
              <div class="dropzone-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line><line x1="8" y1="23" x2="16" y2="23"></line></svg>
              </div>
              <div class="dropzone-text">Drag & drop audio speech, or click to browse</div>
              <div class="dropzone-sub">Supports WAV, MP3, M4A, OGG (Max 25MB)</div>
            </div>

            <div class="media-preview-box" id="audioPreviewContainer">
              <button type="button" class="media-clear-btn" onclick="clearAudio()">✕</button>
              <audio id="audioPlayer" controls></audio>
            </div>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="btn-submit" id="submitBtn">
            <span class="spinner" id="loadingSpinner"></span>
            <span id="btnText">ANALYZE MULTIMODAL AUTHENTICITY</span>
          </button>
        </form>
      </section>

      <!-- Right Column: Results & Diagnostic Dashboard -->
      <section class="glass-card">
        <div class="card-header">
          <h2 class="card-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            Forensic & Cross-Modal Diagnostic
          </h2>
        </div>

        <!-- Initial Empty Placeholder -->
        <div class="empty-state" id="emptyState">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
          <h3 style="margin-bottom: 0.5rem; font-weight: 700; color: #e2e8f0;">No Claim Analyzed Yet</h3>
          <p style="font-size: 0.85rem; max-width: 340px;">Select an evaluation mode, upload an evidence file, and click Analyze to run cross-modal verification.</p>
        </div>

        <!-- Populated Results Container -->
        <div class="results-container" id="resultsContainer">
          <!-- Verdict banner -->
          <div class="verdict-banner fake" id="verdictBanner">
            <div class="verdict-info">
              <h3>Multimodal Verification Result</h3>
              <div class="verdict-title" id="verdictTitle">Fake / Out-of-Context</div>
            </div>
            <div class="gauge-circle">
              <svg>
                <circle class="gauge-bg" cx="40" cy="40" r="36"></circle>
                <circle class="gauge-bar" id="gaugeBar" cx="40" cy="40" r="36" stroke="#EF4444"></circle>
              </svg>
              <div class="gauge-text" id="gaugeText">89%</div>
            </div>
          </div>

          <!-- Video Keyframes Strip (Active for Video) -->
          <div class="keyframes-card" id="keyframesCard">
            <div class="keyframes-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect><line x1="7" y1="2" x2="7" y2="22"></line><line x1="17" y1="2" x2="17" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"></line></svg>
              Sampled Temporal Keyframes:
            </div>
            <div class="keyframes-grid" id="keyframesGrid"></div>
          </div>

          <!-- Whisper Speech Transcript Box (Active for Audio/Video) -->
          <div class="transcript-box" id="transcriptBox">
            <div class="transcript-header">
              <span>🎙️ Whisper ASR Speech Transcript:</span>
              <span id="transcriptMeta" style="color: var(--text-muted); font-size: 0.72rem;">Lang: EN | 100% Match</span>
            </div>
            <div class="transcript-content" id="transcriptContent"></div>
          </div>

          <!-- Live Fact-Check Grounding Card -->
          <div class="factcheck-box" id="factcheckBox" style="display: none;">
            <div class="factcheck-header">
              <span class="factcheck-badge" id="factcheckBadge">🔴 DEBUNKED BY FACT-CHECKERS</span>
              <span class="factcheck-source" id="factcheckSource">Verified by: Journalism Network</span>
            </div>
            <div class="factcheck-title" id="factcheckTitle"></div>
            <a href="#" target="_blank" class="factcheck-link" id="factcheckLink">
              View Verified Investigation Article ↗
            </a>
          </div>

          <!-- Key Diagnostic Metrics -->
          <div class="metrics-grid">
            <div class="metric-card">
              <div class="metric-title" id="metricTitle1">Cross-Modal Coherence</div>
              <div class="metric-value" id="coherenceVal">24.5%</div>
              <div class="progress-bar-bg">
                <div class="progress-bar-fill" id="coherenceBar" style="width: 24.5%; background: #EF4444;"></div>
              </div>
            </div>
            <div class="metric-card">
              <div class="metric-title" id="metricTitle2">Sensationalism Score</div>
              <div class="metric-value" id="sensationalVal">72.0%</div>
              <div class="progress-bar-bg">
                <div class="progress-bar-fill" id="sensationalBar" style="width: 72%; background: #F59E0B;"></div>
              </div>
            </div>
            <div class="metric-card">
              <div class="metric-title" id="metricTitle3">Forensic Artifact Risk</div>
              <div class="metric-value" id="forensicVal">64.0%</div>
              <div class="progress-bar-bg">
                <div class="progress-bar-fill" id="forensicBar" style="width: 64%; background: #8B5CF6;"></div>
              </div>
            </div>
          </div>

          <!-- Explainable AI (XAI) Visual Inspector (Active for Image Mode) -->
          <div class="xai-section" id="xaiSection">
            <div class="tab-header">
              <button class="tab-btn active" onclick="switchXaiTab('gradcam')">Grad-CAM Visual Attention</button>
              <button class="tab-btn" onclick="switchXaiTab('ela')">Error Level Forensics (ELA)</button>
            </div>
            
            <div class="tab-content active" id="tabGradcam">
              <img id="gradcamImg" class="xai-image" src="" alt="Grad-CAM Heatmap">
              <div class="xai-caption">
                <strong>Attention Saliency Map:</strong> Red/Yellow regions indicate visual elements that drove the model's decision regarding semantic discrepancy or tampering.
              </div>
            </div>

            <div class="tab-content" id="tabEla">
              <img id="elaImg" class="xai-image" src="" alt="Error Level Analysis">
              <div class="xai-caption">
                <strong>Compression Error Level Analysis:</strong> Highlights differences in JPEG compression blocks, exposing spliced or pasted foreign objects.
              </div>
            </div>
          </div>

          <!-- Decision Reasoning Details -->
          <div class="reasons-box">
            <div class="reasons-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              Explainable Reasoning (Why this verdict?):
            </div>
            <ul class="reasons-list" id="reasonsList">
              <!-- Dynamically populated -->
            </ul>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script>
    let samplesData = [];
    let currentSelectedBlob = null;
    let currentSelectedVideo = null;
    let currentSelectedAudio = null;
    let currentModality = 'image';

    // Switch Modality Function
    function switchModality(mode) {
      currentModality = mode;
      
      document.querySelectorAll('.modality-tab').forEach(t => t.classList.remove('active'));
      document.getElementById('imageInputGroup').style.display = 'none';
      document.getElementById('videoInputGroup').style.display = 'none';
      document.getElementById('audioInputGroup').style.display = 'none';
      document.getElementById('quickSamplesBox').style.display = 'none';

      const btnText = document.getElementById('btnText');
      const textLabel = document.getElementById('textInputLabel');

      if (mode === 'image') {
        document.getElementById('tabModImage').classList.add('active');
        document.getElementById('imageInputGroup').style.display = 'block';
        document.getElementById('quickSamplesBox').style.display = 'flex';
        textLabel.innerText = "News Claim / Headline / Tweet Text:";
        btnText.innerText = "ANALYZE MULTIMODAL AUTHENTICITY";
      } else if (mode === 'video') {
        document.getElementById('tabModVideo').classList.add('active');
        document.getElementById('videoInputGroup').style.display = 'block';
        textLabel.innerText = "Accompanying News Caption / Claim (Optional):";
        btnText.innerText = "ANALYZE VIDEO MULTIMODAL AUTHENTICITY";
      } else if (mode === 'audio') {
        document.getElementById('tabModAudio').classList.add('active');
        document.getElementById('audioInputGroup').style.display = 'block';
        textLabel.innerText = "Claim Context / Alleged Speaker (Optional):";
        btnText.innerText = "ANALYZE AUDIO & SPEECH AUTHENTICITY";
      }
    }

    // Load available benchmark samples on load
    window.addEventListener('DOMContentLoaded', async () => {
      try {
        const res = await fetch('/api/samples');
        samplesData = await res.json();
        
        // System status
        const sysRes = await fetch('/api/system-status');
        const sys = await sysRes.json();
        if (sys.cuda_available) {
          document.getElementById('gpuStatusText').innerText = `GPU: ${sys.gpu_name} (CUDA Active)`;
        } else {
          document.getElementById('gpuStatusText').innerText = `Engine: Fast CPU Mode`;
        }

        // Preload sample 0
        if (samplesData.length > 0) {
          loadSample(0);
        }
      } catch (e) {
        console.warn("Could not fetch samples or status:", e);
      }
    });

    // Quick Load Sample
    async function loadSample(index) {
      if (!samplesData || !samplesData[index]) return;
      const sample = samplesData[index];
      
      document.querySelectorAll('.chip').forEach((c, i) => {
        c.classList.toggle('active', i === index);
      });

      document.getElementById('headlineText').value = sample.headline;

      try {
        const imgUrl = `/api/sample-image/${sample.image_source}`;
        const response = await fetch(imgUrl);
        const blob = await response.blob();
        currentSelectedBlob = blob;
        
        const previewImg = document.getElementById('previewImg');
        previewImg.src = URL.createObjectURL(blob);
        document.getElementById('previewContainer').style.display = 'block';
        document.getElementById('dropzone').style.display = 'none';
      } catch (err) {
        console.error("Failed to load sample image:", err);
      }
    }

    // Image Input & Dropzone
    const imageInput = document.getElementById('imageInput');
    const dropzone = document.getElementById('dropzone');
    const previewContainer = document.getElementById('previewContainer');
    const previewImg = document.getElementById('previewImg');

    imageInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        currentSelectedBlob = file;
        previewImg.src = URL.createObjectURL(file);
        previewContainer.style.display = 'block';
        dropzone.style.display = 'none';
        document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
      }
    });

    function clearImage() {
      currentSelectedBlob = null;
      imageInput.value = '';
      previewContainer.style.display = 'none';
      dropzone.style.display = 'flex';
    }

    // Video Input & Dropzone
    const videoInput = document.getElementById('videoInput');
    const videoDropzone = document.getElementById('videoDropzone');
    const videoPreviewContainer = document.getElementById('videoPreviewContainer');
    const videoPlayer = document.getElementById('videoPlayer');

    videoInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        currentSelectedVideo = file;
        videoPlayer.src = URL.createObjectURL(file);
        videoPreviewContainer.style.display = 'block';
        videoDropzone.style.display = 'none';
      }
    });

    function clearVideo() {
      currentSelectedVideo = null;
      videoInput.value = '';
      videoPlayer.src = '';
      videoPreviewContainer.style.display = 'none';
      videoDropzone.style.display = 'flex';
    }

    // Audio Input & Dropzone
    const audioInput = document.getElementById('audioInput');
    const audioDropzone = document.getElementById('audioDropzone');
    const audioPreviewContainer = document.getElementById('audioPreviewContainer');
    const audioPlayer = document.getElementById('audioPlayer');

    audioInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        currentSelectedAudio = file;
        audioPlayer.src = URL.createObjectURL(file);
        audioPreviewContainer.style.display = 'block';
        audioDropzone.style.display = 'none';
      }
    });

    function clearAudio() {
      currentSelectedAudio = null;
      audioInput.value = '';
      audioPlayer.src = '';
      audioPreviewContainer.style.display = 'none';
      audioDropzone.style.display = 'flex';
    }

    // Switch XAI Tabs
    function switchXaiTab(tab) {
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

      if (tab === 'gradcam') {
        document.querySelectorAll('.tab-btn')[0].classList.add('active');
        document.getElementById('tabGradcam').classList.add('active');
      } else {
        document.querySelectorAll('.tab-btn')[1].classList.add('active');
        document.getElementById('tabEla').classList.add('active');
      }
    }

    // Submit & Call Appropriate API
    const detectForm = document.getElementById('detectForm');
    const submitBtn = document.getElementById('submitBtn');
    const loadingSpinner = document.getElementById('loadingSpinner');
    const btnText = document.getElementById('btnText');

    detectForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = document.getElementById('headlineText').value.trim();

      let targetUrl = '/api/detect';
      const formData = new FormData();
      if (text) formData.append('text', text);

      if (currentModality === 'image') {
        if (!text) {
          alert("Please enter a headline or claim statement for cross-modal comparison.");
          return;
        }
        if (!currentSelectedBlob) {
          alert("Please provide an image for cross-modal verification.");
          return;
        }
        formData.append('image', currentSelectedBlob, 'evidence.jpg');
        targetUrl = '/api/detect';
      } else if (currentModality === 'video') {
        if (!currentSelectedVideo) {
          alert("Please upload a video file for verification.");
          return;
        }
        formData.append('video', currentSelectedVideo);
        targetUrl = '/api/detect-video';
      } else if (currentModality === 'audio') {
        if (!currentSelectedAudio) {
          alert("Please upload an audio speech file for verification.");
          return;
        }
        formData.append('audio', currentSelectedAudio);
        targetUrl = '/api/detect-audio';
      }

      // UI Loading state
      submitBtn.disabled = true;
      loadingSpinner.style.display = 'inline-block';
      btnText.innerText = 'NEURAL VERIFICATION RUNNING...';

      try {
        const response = await fetch(targetUrl, {
          method: 'POST',
          body: formData
        });
        const data = await response.json();

        if (data.success) {
          renderResults(data);
        } else {
          alert("Detection failed: " + (data.error || "Unknown error"));
        }
      } catch (err) {
        alert("Network or server error: " + err.message);
      } finally {
        submitBtn.disabled = false;
        loadingSpinner.style.display = 'none';
        btnText.innerText = currentModality === 'video' ? 'ANALYZE VIDEO MULTIMODAL AUTHENTICITY' : 
                            (currentModality === 'audio' ? 'ANALYZE AUDIO & SPEECH AUTHENTICITY' : 'ANALYZE MULTIMODAL AUTHENTICITY');
      }
    });

    function renderResults(data) {
      document.getElementById('emptyState').style.display = 'none';
      const resultsContainer = document.getElementById('resultsContainer');
      resultsContainer.style.display = 'block';

      // Verdict Banner
      const verdictBanner = document.getElementById('verdictBanner');
      const verdictTitle = document.getElementById('verdictTitle');
      const gaugeBar = document.getElementById('gaugeBar');
      const gaugeText = document.getElementById('gaugeText');

      if (data.is_fake) {
        verdictBanner.className = 'verdict-banner fake';
        verdictTitle.innerText = data.verdict;
        gaugeBar.style.stroke = '#EF4444';
      } else {
        verdictBanner.className = 'verdict-banner authentic';
        verdictTitle.innerText = data.verdict;
        gaugeBar.style.stroke = '#10B981';
      }

      // Circular gauge offset calculation
      const pct = data.confidence;
      const offset = 226 - (226 * (pct / 100));
      gaugeBar.style.strokeDashoffset = offset;
      gaugeText.innerText = Math.round(pct) + '%';

      // Video Keyframes Strip
      const keyframesCard = document.getElementById('keyframesCard');
      const keyframesGrid = document.getElementById('keyframesGrid');
      if (data.modality === 'video' && data.thumbnails && data.thumbnails.length > 0) {
        keyframesCard.style.display = 'block';
        keyframesGrid.innerHTML = '';
        data.thumbnails.forEach(thumb => {
          const img = document.createElement('img');
          img.className = 'keyframe-thumb';
          img.src = thumb;
          keyframesGrid.appendChild(img);
        });
      } else {
        keyframesCard.style.display = 'none';
      }

      // Whisper Speech Transcript
      const transcriptBox = document.getElementById('transcriptBox');
      const transcriptContent = document.getElementById('transcriptContent');
      const transcriptMeta = document.getElementById('transcriptMeta');
      
      let transcriptText = "";
      let langMeta = "EN";
      if (data.modality === 'video' && data.audio_data && data.audio_data.transcript) {
        transcriptText = data.audio_data.transcript;
        langMeta = (data.audio_data.language || "en").toUpperCase();
      } else if (data.modality === 'audio' && data.transcription && data.transcription.transcript) {
        transcriptText = data.transcription.transcript;
        langMeta = (data.transcription.language || "en").toUpperCase();
      }

      if (transcriptText) {
        transcriptBox.style.display = 'block';
        transcriptContent.innerText = `"${transcriptText}"`;
        transcriptMeta.innerText = `Language: ${langMeta} | ASR Grounding`;
      } else {
        transcriptBox.style.display = 'none';
      }

      // Live Fact-Check Grounding Card
      const factcheckBox = document.getElementById('factcheckBox');
      if (data.fact_check && data.fact_check.matched) {
        factcheckBox.style.display = 'block';
        const hit = data.fact_check.primary_hit;
        document.getElementById('factcheckSource').innerText = 'Verified by: ' + hit.source;
        document.getElementById('factcheckTitle').innerText = '"' + hit.title + '"';
        document.getElementById('factcheckLink').href = hit.link;
        if (data.fact_check.is_debunked) {
          document.getElementById('factcheckBadge').innerText = '🔴 DEBUNKED BY FACT-CHECKERS';
          document.getElementById('factcheckBadge').style.background = 'rgba(239, 68, 68, 0.2)';
          document.getElementById('factcheckBadge').style.borderColor = '#EF4444';
          document.getElementById('factcheckBadge').style.color = '#FCA5A5';
        } else {
          document.getElementById('factcheckBadge').innerText = 'ℹ️ VERIFIED NEWS COVERAGE';
          document.getElementById('factcheckBadge').style.background = 'rgba(59, 130, 246, 0.2)';
          document.getElementById('factcheckBadge').style.borderColor = '#3B82F6';
          document.getElementById('factcheckBadge').style.color = '#93C5FD';
        }
      } else {
        factcheckBox.style.display = 'none';
      }

      // Diagnostic Metrics Adaptation
      const mTitle1 = document.getElementById('metricTitle1');
      const mTitle2 = document.getElementById('metricTitle2');
      const mTitle3 = document.getElementById('metricTitle3');
      const xaiSection = document.getElementById('xaiSection');

      if (data.modality === 'video') {
        xaiSection.style.display = 'none';
        mTitle1.innerText = "Scene Coherence";
        mTitle2.innerText = "Facial Tampering Risk";
        mTitle3.innerText = "Audio Voice Spoof";

        const coh = data.diagnostics.cross_modal_coherence || 50.0;
        const faceRisk = data.diagnostics.face_tampering_risk || 10.0;
        const voiceRisk = data.diagnostics.voice_synthetic_risk || 0.0;

        document.getElementById('coherenceVal').innerText = coh + '%';
        document.getElementById('coherenceBar').style.width = coh + '%';
        document.getElementById('coherenceBar').style.background = coh > 50 ? '#10B981' : '#EF4444';

        document.getElementById('sensationalVal').innerText = faceRisk + '%';
        document.getElementById('sensationalBar').style.width = faceRisk + '%';
        document.getElementById('sensationalBar').style.background = faceRisk > 50 ? '#EF4444' : '#10B981';

        document.getElementById('forensicVal').innerText = voiceRisk + '%';
        document.getElementById('forensicBar').style.width = voiceRisk + '%';
        document.getElementById('forensicBar').style.background = voiceRisk > 50 ? '#EF4444' : '#10B981';

      } else if (data.modality === 'audio') {
        xaiSection.style.display = 'none';
        mTitle1.innerText = "AI Voice Clone Risk";
        mTitle2.innerText = "Pitch Jitter Std";
        mTitle3.innerText = "Speech Sensationalism";

        const voiceRisk = data.diagnostics.voice_synthetic_risk || 15.0;
        const jitter = data.diagnostics.pitch_jitter_hz || 20.0;
        const sens = data.diagnostics.text_sensationalism || 10.0;

        document.getElementById('coherenceVal').innerText = voiceRisk + '%';
        document.getElementById('coherenceBar').style.width = voiceRisk + '%';
        document.getElementById('coherenceBar').style.background = voiceRisk > 50 ? '#EF4444' : '#10B981';

        document.getElementById('sensationalVal').innerText = jitter + ' Hz';
        document.getElementById('sensationalBar').style.width = Math.min(100, jitter * 2) + '%';
        document.getElementById('sensationalBar').style.background = jitter < 10 ? '#EF4444' : '#10B981';

        document.getElementById('forensicVal').innerText = sens + '%';
        document.getElementById('forensicBar').style.width = sens + '%';
        document.getElementById('forensicBar').style.background = sens > 50 ? '#EF4444' : '#10B981';

      } else {
        // Image Mode
        xaiSection.style.display = 'block';
        mTitle1.innerText = "Cross-Modal Coherence";
        mTitle2.innerText = "Sensationalism Score";
        mTitle3.innerText = "Forensic Artifact Risk";

        const coherence = data.diagnostics.cross_modal_coherence;
        const sensationalism = data.diagnostics.text_sensationalism;
        const manipulation = data.diagnostics.image_manipulation_risk;

        document.getElementById('coherenceVal').innerText = coherence + '%';
        document.getElementById('coherenceBar').style.width = coherence + '%';
        document.getElementById('coherenceBar').style.background = coherence > 50 ? '#10B981' : '#EF4444';

        document.getElementById('sensationalVal').innerText = sensationalism + '%';
        document.getElementById('sensationalBar').style.width = sensationalism + '%';
        document.getElementById('sensationalBar').style.background = sensationalism > 50 ? '#EF4444' : '#10B981';

        document.getElementById('forensicVal').innerText = manipulation + '%';
        document.getElementById('forensicBar').style.width = manipulation + '%';
        document.getElementById('forensicBar').style.background = manipulation > 50 ? '#EF4444' : '#10B981';

        if (data.visualizations) {
          document.getElementById('gradcamImg').src = data.visualizations.gradcam_base64;
          document.getElementById('elaImg').src = data.visualizations.ela_base64;
        }
      }

      // Reasoning
      const reasonsList = document.getElementById('reasonsList');
      reasonsList.innerHTML = '';
      (data.risk_factors || []).forEach(reason => {
        const li = document.createElement('li');
        li.innerText = reason;
        reasonsList.appendChild(li);
      });

      // Smooth scroll
      resultsContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  </script>
</body>
</html>
